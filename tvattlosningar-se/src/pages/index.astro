---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "tvättlösningar.se – Expertråd för professionella tvättlösningar";
const pageDescription = "Expert rådgivning och kunskapsresurser för professionella tvättlösningar inom vård, bygg, sport, djurhållning och räddningstjänst.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="relative bg-gradient-to-br from-blue-600 to-blue-800 text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 sm:py-40">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6">
          Expertråd för professionella tvättlösningar
        </h1>
        <p class="text-xl sm:text-2xl text-blue-100 mb-12 max-w-3xl mx-auto">
          Få hjälp att välja rätt tvättlösning för din bransch. Baserat på vårdarvserfarenhet och direktkontakt med beslutsfattare.
        </p>
        <p class="text-lg text-blue-200 mb-10">
          Välj din bransch för att komma igång:
        </p>
      </div>

      <!-- Branschkort -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <a href="/vard-och-hygien" class="bg-white text-gray-900 rounded-xl p-8 hover:shadow-2xl transition transform hover:-translate-y-1">
          <div class="text-4xl mb-4">🏥</div>
          <h2 class="text-2xl font-bold mb-3">Vård & Hygien</h2>
          <p class="text-gray-600">
            För sjukhus, äldreboenden och vårdmottagningar som behöver hygieniska tvättlösningar.
          </p>
        </a>

        <a href="/bygg-och-fastighet" class="bg-white text-gray-900 rounded-xl p-8 hover:shadow-2xl transition transform hover:-translate-y-1">
          <div class="text-4xl mb-4">🏗️</div>
          <h2 class="text-2xl font-bold mb-3">Bygg & Fastighet</h2>
          <p class="text-gray-600">
            För byggprojekt och fastighetsförvaltning med fokus på LCC och bullerfri installation.
          </p>
        </a>

        <a href="/sport-och-fritid" class="bg-white text-gray-900 rounded-xl p-8 hover:shadow-2xl transition transform hover:-translate-y-1">
          <div class="text-4xl mb-4">⚽</div>
          <h2 class="text-2xl font-bold mb-3">Sport & Fritid</h2>
          <p class="text-gray-600">
            För idrottsanläggningar som behöver hantera höga volymer och toppbelastning.
          </p>
        </a>

        <a href="/djurhallning" class="bg-white text-gray-900 rounded-xl p-8 hover:shadow-2xl transition transform hover:-translate-y-1">
          <div class="text-4xl mb-4">🐕</div>
          <h2 class="text-2xl font-bold mb-3">Djurhållning</h2>
          <p class="text-gray-600">
            För veterinärkliniker och djurpensionat med specialbehov för djurhår och hygien.
          </p>
        </a>

        <a href="/raddningstjanst" class="bg-white text-gray-900 rounded-xl p-8 hover:shadow-2xl transition transform hover:-translate-y-1">
          <div class="text-4xl mb-4">🚒</div>
          <h2 class="text-2xl font-bold mb-3">Räddningstjänst</h2>
          <p class="text-gray-600">
            För brandstationer som behöver dekontaminera skyddsutrustning från karcinogener.
          </p>
        </a>

        <a href="/leasing" class="bg-white text-gray-900 rounded-xl p-8 hover:shadow-2xl transition transform hover:-translate-y-1">
          <div class="text-4xl mb-4">💰</div>
          <h2 class="text-2xl font-bold mb-3">Leasing & Finansiering</h2>
          <p class="text-gray-600">
            Lär dig om funktionshyra, leasing och direktköp – vad som passar just er.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Snabbåtkomst till verktyg -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Kostnadsfria verktyg & resurser
        </h2>
        <p class="text-lg text-gray-600">
          Börja planera din tvättlösning direkt
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <a href="/verktyg/roi-kalkylator" class="bg-white rounded-lg p-6 shadow-md hover:shadow-xl transition">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">ROI-kalkylator</h3>
          <p class="text-gray-600">Jämför köp, leasing och funktionshyra över 10 år</p>
        </a>

        <a href="/verktyg/volymberaknare-vard" class="bg-white rounded-lg p-6 shadow-md hover:shadow-xl transition">
          <div class="text-3xl mb-3">📊</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Volymberäknare</h3>
          <p class="text-gray-600">Räkna ut hur många maskiner ni faktiskt behöver</p>
        </a>

        <a href="/verktyg/beredskapsquiz" class="bg-white rounded-lg p-6 shadow-md hover:shadow-xl transition">
          <div class="text-3xl mb-3">✅</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Beredskapsquiz</h3>
          <p class="text-gray-600">Testa hur redo ni är för upphandlingen (2 min)</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
