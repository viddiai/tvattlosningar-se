---
interface Props {
  title: string;
  description: string;
  benefits: string[];
  ctaText: string;
  ctaHref: string;
  trustElements: string[];
}

const { title, description, benefits, ctaText, ctaHref, trustElements } = Astro.props;
---

<section class="py-16 sm:py-24 bg-gradient-to-br from-blue-600 to-blue-800 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4">
      {title}
    </h2>

    <p class="text-xl text-blue-100 mb-8">
      {description}
    </p>

    <div class="bg-blue-700/50 rounded-lg p-6 mb-8 text-left max-w-2xl mx-auto">
      <p class="text-blue-100 font-semibold mb-4">I samtalet hjälper vi dig att:</p>
      <ul class="space-y-2">
        {benefits.map((benefit) => (
          <li class="flex items-start">
            <span class="text-blue-300 mr-2">•</span>
            <span class="text-blue-50">{benefit}</span>
          </li>
        ))}
      </ul>
    </div>

    <a
      href={ctaHref}
      class="inline-block bg-white text-blue-600 px-10 py-4 rounded-lg text-lg font-bold hover:bg-gray-100 transition shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5"
    >
      {ctaText}
    </a>

    <div class="mt-8 space-y-2">
      {trustElements.map((element) => (
        <p class="text-blue-100 text-sm">
          ✓ {element}
        </p>
      ))}
    </div>

    <p class="mt-6 text-blue-200 text-sm">
      Föredrar du mejl? Skriv till <a href="mailto:expert@tvattlosningar.se" class="underline hover:text-white">expert@tvattlosningar.se</a>
    </p>
  </div>
</section>
