---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  intro: string;
  items: FAQItem[];
  closingText?: string;
  ctaText?: string;
  ctaHref?: string;
}

const { title, intro, items, closingText, ctaText, ctaHref } = Astro.props;
---

<section id="faq" class="py-16 sm:py-24 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      <p class="text-lg text-gray-600">
        {intro}
      </p>
    </div>

    <div class="space-y-4">
      {items.map((item, index) => (
        <details class="group bg-gray-50 rounded-lg p-6 hover:bg-gray-100 transition cursor-pointer">
          <summary class="flex justify-between items-center font-semibold text-lg text-gray-900 list-none">
            <span>{item.question}</span>
            <span class="ml-4 flex-shrink-0 text-blue-600 group-open:rotate-180 transition-transform">
              ▼
            </span>
          </summary>
          <div class="mt-4 text-gray-600 leading-relaxed" set:html={item.answer} />
        </details>
      ))}
    </div>

    {closingText && (
      <div class="mt-12 text-center">
        <p class="text-lg text-gray-700 mb-6">
          {closingText}
        </p>
        {ctaText && ctaHref && (
          <a
            href={ctaHref}
            class="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition"
          >
            {ctaText}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
