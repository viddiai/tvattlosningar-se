---
interface Problem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  intro: string;
  problems: Problem[];
  closingText: string;
}

const { title, intro, problems, closingText } = Astro.props;
---

<section id="problem" class="py-16 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        {intro}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {problems.map((problem) => (
        <div class="bg-gray-50 rounded-lg p-6 hover:shadow-lg transition">
          <div class="text-4xl mb-4">{problem.icon}</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            {problem.title}
          </h3>
          <p class="text-gray-600">
            {problem.description}
          </p>
        </div>
      ))}
    </div>

    <p class="text-center text-lg text-gray-700 font-medium">
      {closingText}
    </p>
  </div>
</section>
